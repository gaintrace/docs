{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "GainTrace",
  "description": "GainTrace API documentation",
  "colors": {
    "primary": "#FFAC00",
    "light": "#FFAC00",
    "dark": "#FFAC00"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Developer Docs",
        "icon": "books",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "errors"
            ]
          }
        ]
      },
      {
        "tab": "Help Center",
        "icon": "chart-donut-3",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "help/index",
              "help/getting-started/what-is-gaintrace",
              "help/getting-started/for-admins",
              "help/getting-started/for-csms"
            ]
          },
          {
            "group": "Records",
            "pages": [
              "help/records/companies",
              "help/records/people",
              "help/records/revenue",
              "help/records/data-model"
            ]
          },
          {
            "group": "Health and triage",
            "pages": [
              "help/accounts/health",
              "help/accounts/triage",
              "help/accounts/adoption"
            ]
          },
          {
            "group": "Automating workflows",
            "pages": [
              "help/automation/flows"
            ]
          },
          {
            "group": "Boards",
            "pages": [
              "help/boards/boards"
            ]
          },
          {
            "group": "Customer success",
            "pages": [
              "help/success/success-plans",
              "help/success/champion-tracking"
            ]
          },
          {
            "group": "Connecting your data",
            "pages": [
              "help/integrations/integrations",
              "help/integrations/ingestion-filters",
              "help/integrations/email-calendar",
              "help/integrations/google-oauth-client",
              {
                "group": "Popular integrations",
                "pages": [
                  "help/integrations/hubspot",
                  "help/integrations/salesforce",
                  "help/integrations/attio",
                  "help/integrations/stripe",
                  "help/integrations/paddle",
                  "help/integrations/intercom",
                  "help/integrations/slack",
                  "help/integrations/posthog",
                  "help/integrations/mixpanel",
                  "help/integrations/gong"
                ]
              }
            ]
          },
          {
            "group": "Trace AI",
            "pages": [
              "help/trace-ai/trace-ai"
            ]
          },
          {
            "group": "Workspace admin",
            "pages": [
              "help/admin/members",
              "help/admin/teams",
              "help/admin/billing",
              "help/admin/governance"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Companies",
            "pages": [
              "GET /companies",
              "POST /companies",
              "GET /companies/{id}",
              "PATCH /companies/{id}"
            ]
          },
          {
            "group": "Contacts",
            "pages": [
              "GET /contacts",
              "POST /contacts",
              "GET /contacts/{id}",
              "PATCH /contacts/{id}",
              "DELETE /contacts/{id}"
            ]
          },
          {
            "group": "Signals",
            "pages": [
              "GET /signals",
              "POST /signals",
              "POST /signals/batch",
              "GET /signals/{id}",
              "PATCH /signals/{id}",
              "DELETE /signals/{id}"
            ]
          },
          {
            "group": "Ingest",
            "pages": [
              "POST /events",
              "POST /metric-events"
            ]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "icon": "webhook",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Guide",
            "pages": [
              "webhooks"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "GET /webhooks",
              "POST /webhooks",
              "GET /webhooks/{id}",
              "PATCH /webhooks/{id}",
              "DELETE /webhooks/{id}",
              "POST /webhooks/{id}/test"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "/logo/mcp.svg",
        "pages": [
          "mcp-server"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/GainTrace-logo-light.svg",
    "dark": "/images/GainTrace-logo-dark.svg",
    "href": "https://gaintrace.com/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.gaintrace.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://gaintrace.com"
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ],
      "prefill": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "codeblocks": "system"
  },
  "fonts": {
    "family": "Geist"
  },
  "thumbnails": {
    "background": "/images/gaintrace-og.jpg"
  },
  "metadata": {
    "timestamp": true
  },
  "redirects": [
    {
      "source": "/members",
      "destination": "/help/admin/members"
    },
    {
      "source": "/teams",
      "destination": "/help/admin/teams"
    },
    {
      "source": "/mcp",
      "destination": "/mcp-server"
    }
  ]
}
