{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "GainTrace",
  "description": "GainTrace API documentation",
  "colors": {
    "primary": "#FFAC00",
    "light": "#FFAC00",
    "dark": "#FFAC00"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "authentication"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "terminal",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Accounts",
            "pages": ["GET /accounts", "POST /accounts", "GET /accounts/{id}", "PATCH /accounts/{id}"]
          },
          {
            "group": "Contacts",
            "pages": ["GET /contacts", "POST /contacts", "GET /contacts/{id}", "PATCH /contacts/{id}", "DELETE /contacts/{id}"]
          },
          {
            "group": "Signals",
            "pages": ["GET /signals", "POST /signals", "POST /signals/batch", "GET /signals/{id}", "PATCH /signals/{id}", "DELETE /signals/{id}"]
          },
          {
            "group": "Ingest",
            "pages": ["POST /events", "POST /metric-events"]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "icon": "webhook",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Guide",
            "pages": ["webhooks"]
          },
          {
            "group": "Endpoints",
            "pages": ["GET /webhooks", "POST /webhooks", "GET /webhooks/{id}", "PATCH /webhooks/{id}", "DELETE /webhooks/{id}", "POST /webhooks/{id}/test"]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "plug",
        "pages": ["mcp-server"]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.gaintrace.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://gaintrace.com"
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": ["bash", "javascript", "python"],
      "prefill": true
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "icons": {
    "library": "lucide"
  }
}
