{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GainTrace",
  "description": "GainTrace API documentation",
  "colors": {
    "primary": "#E8940F",
    "light": "#F5B94B",
    "dark": "#C97C0A"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "authentication"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Accounts",
            "pages": ["GET /accounts"]
          },
          {
            "group": "Signals",
            "pages": ["GET /signals", "POST /signals"]
          },
          {
            "group": "Ingest",
            "pages": ["POST /events", "POST /metric-events"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.gaintrace.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://gaintrace.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  }
}
